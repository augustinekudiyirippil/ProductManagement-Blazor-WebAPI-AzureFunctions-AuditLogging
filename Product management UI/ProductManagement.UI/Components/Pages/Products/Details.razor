

@page "/products/details/{Id:int}"

@using Microsoft.AspNetCore.Components.Forms
@using ProductManagement.UI.Models
@using ProductManagement.UI.DTOs
@using ProductManagement.UI.Services
@using Microsoft.JSInterop


@inject IProductImageService ProductImageService
@inject ProductApiService ProductApiService
@inject IJSRuntime JS

<a href="/products">
    Back to  Products
</a>

<h3>Product Details</h3>

@if (product == null)
{
    <p>Loading...</p>
}
else
{
    <dl class="row">

        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@product.Id</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@product.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@product.Description</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@product.Price</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@product.CreatedDate</dd>

    </dl>

    <hr />

    <h4>Upload Images</h4>

    <InputFile OnChange="HandleFileSelected"  />
    <div class="form-check mt-2">

        <input type="checkbox"
               class="form-check-input"
               @bind="isPrimary" />

        <label class="form-check-label">
            Set as Primary Image
        </label>

    </div>

    <br />
    <br />

    <button class="btn btn-primary"
            @onclick="UploadImage">
        Upload Image
    </button>




    <hr />

    <h4>Primary Image</h4>

    @if (images.Any(x => x.IsPrimary))
    {
        var primaryImage =
            images.First(x => x.IsPrimary);

        <div class="mb-3">
@* 
            <img src="@primaryImage.BlobUrl"
                 alt="@primaryImage.FileName"
                 style="
            max-width:400px;
            max-height:400px;
            border:1px solid #ccc;
            padding:5px;
            border-radius:8px;" /> *@
            <img src="@primaryImage.SasUrl"
                 alt="@primaryImage.FileName"
                 style="
            max-width:400px;
            max-height:400px;
            border:1px solid #ccc;
            padding:5px;
            border-radius:8px;" />

            <div class="mt-2">
                <strong>@primaryImage.FileName</strong>
            </div>

        </div>
    }
    else
    {
        <p>No primary image available.</p>
    }

    <hr />

    <h4>Image Gallery</h4>

    @if (images.Any())
    {
        <div class="d-flex flex-wrap">

            @foreach (var image in images)
            {
                <div class="m-2 text-center">

                  @*   <img src="@image.BlobUrl"
                         alt="@image.FileName"
                         style="
                    width:120px;
                    height:120px;
                    object-fit:cover;
                    border:1px solid #ccc;
                    border-radius:6px;" /> *@

                    <img src="@image.SasUrl"
                         alt="@image.FileName"
                         style="
                    width:120px;
                    height:120px;
                    object-fit:cover;
                    border:1px solid #ccc;
                    border-radius:6px;" />


                    <div class="mt-2">

                        @if (image.IsPrimary)
                        {
                            <span class="badge bg-success">
                                Primary
                            </span>
                        }

                    </div>

                    <div class="mt-1">
                        @image.FileName
                    </div>
                    <div class="mt-2">

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => ConfirmDeleteImage(image.Id)">
                            Delete
                        </button>

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <p>No images uploaded.</p>
    }
}

@code
{
    [Parameter]
    public int Id { get; set; }

    private Product? product;

    // protected override async Task OnInitializedAsync()
    // {
    //     product =
    //         await ProductApiService.GetProductByIdAsync(Id);
    // }

    protected override async Task OnInitializedAsync()
    {
        product =
            await ProductApiService
                .GetProductByIdAsync(Id);

        await LoadImages();
    }

    // private List<IBrowserFile>
    // selectedFiles = new();

    private IBrowserFile? selectedFile;

    private bool isPrimary;

    private List<ProductImageDto>
        images = new();

    private void HandleFileSelected(
      InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadImage()
    {
        if (selectedFile == null)
            return;

        await ProductImageService
            .UploadImageAsync(
                Id,
                selectedFile,
                isPrimary);

        selectedFile = null;
        isPrimary = false;

        await LoadImages();

        StateHasChanged();
    }


    private async Task LoadImages()
    {
        images =
            await ProductImageService
                .GetImagesAsync(Id);
    }


    private async Task DeleteImage(
    int imageId)
    {
        await ProductImageService
            .DeleteImageAsync(imageId);

        await LoadImages();

        StateHasChanged();
    }


    private async Task ConfirmDeleteImage(
    int imageId)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                "Are you sure you want to delete this image?");

        if (!confirmed)
            return;

        await DeleteImage(imageId);
    }

}